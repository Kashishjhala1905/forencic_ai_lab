# Copy to backend/.env and edit. Never commit the real .env file.
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, a random secret is generated at each start (all logins are invalidated on restart).
JWT_SECRET=YaBCd6PtytYbftVFiEzes9ck_ZpGLCyYvVX4-XEdh4KJ_SfX1H5GYFwCeqH46Rtj
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
# Leave empty to use ../storage (uploads, heatmaps, reports and the SQLite DB live there)
STORAGE_DIR=
DATABASE_PATH=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe  (leave empty if tesseract is on PATH)
TESSERACT_CMD=
OCR_LANG=eng
# Comma-separated e-mails that receive the admin role when they register
ADMIN_EMAILS=
# Optional JSON file overriding risk weights/thresholds (see docs/RISK_SCORING.md)
RISK_CONFIG_PATH=
